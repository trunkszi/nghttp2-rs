    pub origin: *mut u8,
    pub origin_len: usize,
}
#[repr(C)]
#[derive(Debug, Copy, Clone)]
pub struct nghttp2_ext_origin {
    pub nov: usize,
    pub ov: *mut nghttp2_origin_entry,
}
unsafe extern "C" {
    pub fn nghttp2_submit_origin(
        session: *mut nghttp2_session,
        flags: u8,
        ov: *const nghttp2_origin_entry,
        nov: usize,
    ) -> ::std::os::raw::c_int;
}
